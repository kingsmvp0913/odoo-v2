{
  "name": "aidev",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "test": "jest --runInBand",
    "test:quiet": "jest --runInBand --silent --noStackTrace --no-color",
    "rwd:baseline": "node rwd/capture.js --baseline",
    "rwd:capture": "node rwd/capture.js",
    "rwd:check": "node rwd/capture.js && node rwd/compare.js",
    "rwd:gate": "node rwd/capture.js --gate-only && node rwd/compare.js --gate-only",
    "rwd:inventory": "node rwd/inventory/scan.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@upstash/context7-mcp": "^3.2.3",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^12.7.0",
    "multer": "^2.2.0",
    "mysql2": "^3.22.6",
    "node-cron": "^3.0.3",
    "pg": "^8.22.0",
    "socket.io": "^4.7.5",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "pg-mem": "^2.9.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
