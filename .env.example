# 同構掛載路徑：宿主路徑必須與容器內路徑「完全相同」。
# 原因：平台在容器內 spawn `docker run -v <path>:...` 建立測試區時，該路徑是由「宿主的 docker
# daemon」解讀的；容器內外路徑不同會讓測試區掛到不存在的目錄，自訂 addons 全數遺失。
# 依你的實際位置調整後另存為 .env（.env 不進版控）。
HOST_REPO_DIR=/home/odoo/odoo-v2
HOST_ENV_BASE=/home/odoo/odoo-envs

# 時區。容器預設 UTC，不設會讓測試區夜間關機（預設 23:00）落在台灣早上 7 點。
TZ=Asia/Taipei

# —— 以下皆為「掛在既有網域下」才需要，留空＝維持本機直連行為 ——

# ── 測試區對外曝露（port 模式，全 opt-in；未設＝每專案 127.0.0.x loopback 直連，本機/Windows 行為不變）──
# 所有測試區共用一個裸網域、靠 port 區分（https://<網域>:<port>）。不用 wildcard 子網域是因為 DNS
# 若在不支援 * 記錄／無 ACME API 的商（如 Wix），wildcard 起不來；port 模式只需裸網域一張 HTTP-01 憑證。
# cookie 依 host 隔離、不看 port——同網域多埠共用 cookie；真人一次操作一個、E2E 各自獨立 context，不受影響。

# 測試區容器發佈到宿主的位址。反代 nginx 多跑在另一個容器（bridge 網路），連不到宿主 loopback，
# 故設成 docker 橋接閘道（`ip -4 addr show docker0`，本機為 10.0.0.1）。此位址會實際監聽，務必以
# 防火牆/VPN 只放行 nginx／可信來源——測試區跑未審程式碼，且與平台共用 PostgreSQL superuser。
#ENV_BIND_HOST=10.0.0.1

# 使用者瀏覽器要開的測試區網址樣板。不設＝直接給 http://<綁定位址>:<port>，只有宿主本機連得到。
# port 模式用 {port}；憑證只認主機名不認 port，一張蓋全部埠。（{folder}／{host} 亦可用。）
#ENV_PUBLIC_URL_TEMPLATE=https://odoo-ai-dev.example.com:{port}

# 共用 nginx 容器名（平台對它 docker exec nginx -t／-s reload）。
#NGINX_CONTAINER=agency-NginxUI-1

# nginx 同步總 gate：平台把每個 running 測試區寫成一段 `listen <port> ssl` server block 到此檔。
# 須為 odoo-v2 容器寫得到、且已 include 進 agency-NginxUI-1 之 http{} 的共享路徑（雙容器掛同一宿主檔）。
#NGINX_SYNC_CONF_FILE=/etc/nginx/conf.d/odoo-envs.conf

# 裸網域憑證／私鑰路徑（agency-NginxUI-1 容器內；NginxUI 簽 HTTP-01 後多在 /etc/nginx/ssl/<域>_P256/）。
#ENV_TLS_CERT=/etc/nginx/ssl/odoo-ai-dev.example.com_P256/fullchain.cer
#ENV_TLS_KEY=/etc/nginx/ssl/odoo-ai-dev.example.com_P256/private.key
