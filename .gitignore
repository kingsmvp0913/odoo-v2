# ─── Node ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ─── Odoo 執行期工作區(runtime,非原始碼)──────────────
# 各專案的 clone 與虛擬環境,由 pipeline 動態產生
/odoo-envs/
/repos/
# 企業版 addons 共用來源(ENTERPRISE_BASE_DIR 預設位置,各大版本一個子目錄)。
# 是有授權的專有碼且動輒數百 MB,無論由平台 clone 或管理員自行放入都不進版控。
/enterprise/

# ─── 附件磁碟儲存(runtime,非原始碼)────────────────
# 使用者上傳/同步下來的附件本體,測試與正式環境都會實際寫入這裡
/app/uploads/

# ─── 機密設定(改用 config.example.json 交付)──────────
/data/config.json
/data/config.json.host-backup
/data/claude-usage.json
# 用量小工具的執行期快照與校準樣本(每台機器各自累積,無交付價值)
/data/claude-rate-limit.json
/data/claude-usage-calibration.jsonl
# VPN 撥號時解密後的暫存 .ovpn(含憑證),用後即刪,絕不進版控
/data/vpn-tmp/
# embedding 模型權重(約 130 MB,首次啟動自動下載;離線環境可事先放進來)
/data/models/
.env
.env.*
!.env.example
docker-compose.override.yml
.firecrawl/

# ─── 工具快取 ───────────────────────────────────────────

# ─── RWD 截圖的執行期產物 ───────────────────────────
# 只有 inventory/ 進版控。baseline/ 會把正式區畫面上的真實資料
# (任務標題、專案名稱、用量數字)拍進 git 歷史,刪不掉,故排除——
# 代價是門禁不可攜,只在產基線的那台機器上有效。
/app/rwd/snapshots/
/app/rwd/diff/
/app/rwd/baseline/
# 截圖用的中文字型（32MB 二進位，不進版控；缺了就重抓，指令在 app/rwd/README.md）
/app/rwd/.fontroot/
# 截圖用的 Chromium（650MB，不進版控；缺了就重裝，指令在 app/rwd/README.md）
/app/rwd/.pw-browsers/

# ─── 編輯器 / 作業系統 ──────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ─── 日誌 ───────────────────────────────────────────────
*.log

# ─── 設計史料(本機保留,不進 git)──────────────────
/docs/

# Claude Code 本機個人設定（每台機器各異，不進版控）
.claude/settings.local.json
# 執行期生成的 MCP 設定（claude-runner 依本機安裝位置產生）
app/server/pipeline/mcp/context7.local.json
# 執行期生成的掃碟守衛 settings（claude-runner 依本機 hook 腳本路徑產生）
app/server/pipeline/hooks/scan-guard.settings.json
/data/odoo-core/

# graphify 手動工具（scripts/graphify_index.py）的產物：自動索引已移除，圖只在跑的當下正確、
# 無任何程式或 AI 指示在讀它。留在版控只是讓每次 clone 多拉十幾 MB 的化石。
/graphify-out/
